# Database Configuration
# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:port/database

# Supabase Configuration
# Client-side (must be prefixed with VITE_ for Vite to expose them)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side Supabase (use anon key for most operations, or service key for admin operations)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# Optional: Use service key for admin operations (more permissions)
# SUPABASE_SERVICE_KEY=your-service-key-here

# MailerLite Integration (Optional)
MAILERLITE_API_KEY=your-mailerlite-api-key
MAILERLITE_USERS_GROUP_ID=your-users-group-id
MAILERLITE_ARTISTS_GROUP_ID=your-artists-group-id

# Server Configuration
PORT=5000
NODE_ENV=development

# Push notification preference gating (Phase B). When not "true", sendPushToUser ignores user_notification_preferences.
# PUSH_PREF_GATING_ENABLED=true

# RevenueCat — server-only secret API key for authoritative REST refresh.
# NEVER prefix with VITE_ (must not be exposed to the client bundle).
# NEVER commit a real sk_ value. Set this in Railway before deployed verification.
# REVENUECAT_SECRET_API_KEY=sk_replace_me

# RevenueCat — public SDK keys only. Never put secret/sk_/ASC .p8 keys in VITE_ vars.
#
# Explicit app build channel for Capacitor/native bundles (not Vite DEV/PROD).
# - local: local native diagnostics builds (Xcode / Capacitor from a local vite build)
# - testflight: TestFlight builds
# - production: App Store / release builds
# A plain `vite build` sets import.meta.env.PROD=true; do NOT use that for RC provider selection
# or for native API origin selection.
# VITE_APP_BUILD_CHANNEL=local
#
# Server-side mirror for delivery eligibility (listener-facing deliveryEnabled).
# Same values as VITE_APP_BUILD_CHANNEL. Prefer APP_BUILD_CHANNEL on Railway;
# local/dev may rely on VITE_APP_BUILD_CHANNEL from the shared .env.
# APP_BUILD_CHANNEL=local
#
# Server-only free release-creation limit enforcement (exact value "true" enables).
# When unset/false/invalid: unrestricted creation (current behaviour); ledger still written.
# Do not use a VITE_* variable. Set true on Railway only after local verification.
# ARTIST_SUBSCRIPTION_RELEASE_LIMIT_ENFORCEMENT=false
#
# Server-only free per-release attachment limit (exact value "true" enables).
# Free artists: max 3 attached posts/clips per release. Paid: unlimited.
# ARTIST_SUBSCRIPTION_ATTACHMENT_LIMIT_ENFORCEMENT=false
#
# Server-only free per-release link limit (exact value "true" enables).
# Free artists: max 1 primary listening link per release. Paid: unlimited
# (including presave / download / free_download / dub_pack). Do not use a VITE_* variable.
# ARTIST_SUBSCRIPTION_LINK_LIMIT_ENFORCEMENT=false
#
# Server-only free future-release subscription suspension (exact value "true" enables).
# Free artists: max 2 active public future/coming-soon releases; extras are reversibly
# suspended (not deleted) until resubscribe. Do not use a VITE_* variable.
# ARTIST_SUBSCRIPTION_FUTURE_RELEASE_SUSPENSION_ENFORCEMENT=false
#
# Client production Verified Artist Tools paywall (exact value "true" enables).
# When unset/false: Upgrade CTAs keep the purchase placeholder toast.
# Does not bypass server entitlement rules. Requires native iOS + RevenueCat identity.
# VITE_VERIFIED_ARTIST_TOOLS_PAYWALL_ENABLED=false
#
# Client Home Screen widget listener selection UI (exact value "true" enables).
# When unset/false: Use in widget / Selected for widget actions stay hidden.
# Does not alter GET /api/widget/home-release or server eligibility rules.
# Native App Group + WidgetKit arrive in a later phase; this flag only gates selection UX.
# VITE_HOME_RELEASE_WIDGET_SELECTION_ENABLED=false
#
# Native API origins (Capacitor):
# - local channel: uses VITE_DEV_API_ORIGIN (LAN/dev backend), falls back to VITE_API_ORIGIN
# - testflight/production: must use VITE_API_ORIGIN (hosted backend)
# VITE_DEV_API_ORIGIN=http://192.168.1.x:5001
# VITE_API_ORIGIN=https://your-api.example.com
#
# Apple App Store public iOS SDK key (appl_…). Default provider for all channels.
# VITE_REVENUECAT_IOS_PUBLIC_API_KEY=appl_xxx
#
# RevenueCat Test Store public SDK key (local channel only).
# WARNING: Never set VITE_REVENUECAT_TEST_STORE_API_KEY or VITE_REVENUECAT_USE_TEST_STORE
# in TestFlight or production environments. Omit those vars entirely for those builds.
# Provider changes require a rebuild and app relaunch (configure once per process).
# VITE_REVENUECAT_TEST_STORE_API_KEY=test_xxx
# VITE_REVENUECAT_USE_TEST_STORE=true
#
# Optional: force identity diagnostics outside Vite DEV builds (native Xcode logs / Settings panel)
# VITE_FORCE_REVENUECAT_IDENTITY_DIAGNOSTICS=true
